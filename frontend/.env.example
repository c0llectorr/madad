# Copy this file to .env and fill in the actual backend IP
# During local dev: use Muhammad Ahmad's machine IP (not localhost — phone can't reach localhost)
# e.g. http://192.168.1.42:8000/api
# For deployed backend: use the Alibaba Cloud endpoint URL

EXPO_PUBLIC_API_BASE_URL=http://<backend-dev-ip>:8000/api

# Set to true to run the app entirely on local mock data (no backend needed).
# Set to false (or remove) when the real backend is ready.
EXPO_PUBLIC_USE_MOCK=true
