{
	"useTabs": true,
	"tabWidth": 4,
	"endOfLine": "lf",
	"trailingComma": "es5",
	"semi": false,
	"singleQuote": true,
	"bracketSpacing": true,
	"arrowParens": "always",
	"overrides": [
		{
			"files": ["*.json", "*.yml", "*.yaml"],
			"options": {
				"useTabs": false,
				"tabWidth": 2
			}
		}
	]
}
